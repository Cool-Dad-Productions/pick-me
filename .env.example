# Database (Neon Postgres pooled connection string)
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: Seed admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Google Books API (future)
GOOGLE_BOOKS_API_KEY=

# Set to "true" to enable user sign ups; unset or any other value disables sign ups
ENABLE_SIGN_UP=
